{
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "dev/**",
      "tests/**",
      "tools/**",
      "package*.json",
      "firebase.test.json",
      "firestore.*",
      "*.md",
      "icons/make-icons.ps1"
    ],
    "cleanUrls": false,
    "headers": [
      {
        "//": "Never cache the service worker or updates stop reaching phones.",
        "source": "/sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "//": "The entry point revalidates on every launch.",
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          { "key": "Content-Type", "value": "application/manifest+json" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "//": "The app is offline-first; the service worker owns freshness.",
        "source": "**/*.@(js|css|png)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      }
    ]
  }
}
